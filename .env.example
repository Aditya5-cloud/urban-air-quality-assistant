# ─── Gemini GenAI Configuration ──────────────────────────────
# Obtain your free API key at https://aistudio.google.com/app/apikey
# Real GenAI generation is active when GEMINI_API_KEY is supplied.
# If unset, the server transparently uses an offline deterministic scientific simulation.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ─── Live Atmospheric Data Provider (Open-Meteo) ─────────────
# Real-time PM2.5, US AQI, temperature, and inversion risk are fetched
# directly via Open-Meteo's open global meteorological API.
# Zero API key required (100% free, keyless, rate-limit friendly).

# ─── Server & Session Configuration ──────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# Stateless in-memory repository session TTL (in days)
SESSION_TTL_DAYS=7

# ─── Rate Limiting & Security ────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
