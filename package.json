{
  "name": "urban-air-quality-assistant",
  "version": "1.0.0",
  "description": "GenAI-powered assistant helping families navigate winter smog and urban air pollution",
  "private": true,
  "scripts": {
    "build": "npm --prefix client run build",
    "vercel-build": "npm --prefix client install && npm --prefix client run build",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client start",
    "client:dev": "npm --prefix client run dev",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test": "npm run test:server && npm run test:client",
    "typecheck": "npm --prefix client run typecheck",
    "lint:server": "npm --prefix server run lint",
    "lint:client": "npm --prefix client run lint",
    "lint": "npm run lint:server && npm run lint:client"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "uuid": "^10.0.0"
  }
}
